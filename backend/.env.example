# Copie ce fichier en ".env" et remplis-le. Ne commit JAMAIS le fichier ".env".

PORT=3001
# En production derrière Nginx : 127.0.0.1 (le serveur n'est pas joignable directement depuis Internet)
HOST=127.0.0.1

# Adresse(s) du frontend autorisée(s) à appeler l'API, séparées par des virgules (sans "/" final)
# En local : http://localhost:5173 — en production : l'URL Vercel (+ ton domaine si tu en as un)
CORS_ORIGIN=http://localhost:5173

# Mot de passe de la page /admin (16 caractères minimum). Génère-en un avec :
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_TOKEN=

# Dossier de la base SQLite et des photos (à sauvegarder régulièrement)
DATA_DIR=./data

# E-mails (facultatif). Sans SMTP, les messages sont quand même enregistrés et visibles dans /admin.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Dakar Accueil 2026 <no-reply@exemple.com>"
# Reçoit une copie des messages « objets perdus » et les demandes d'assistance
ADMIN_EMAIL=
